# Default: normalize text files to LF in the repo and on checkout.
* text=auto eol=lf

# Must stay LF even when cloned on Windows: a CRLF shebang/entrypoint makes the container fail with
# "exec ...: no such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.template text eol=lf

*.png binary
*.pdf binary
